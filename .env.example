# ── GRC Platform Environment Variables ──────────────
# Copy this file to .env and fill in the secrets.

# ── Django Core ──
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ── PostgreSQL Database ──
DB_NAME=grc_platform
DB_USER=grc_admin
DB_PASSWORD=grc_secret_2026
DB_HOST=db
DB_PORT=5432

# ── SMTP Configuration (Notifications) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_USE_TLS=True

# ── Redis / Celery ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Wazuh Manager API ──
# Required: docker-compose uses variable substitution for WAZUH_API_PASSWORD
# Ensure this is set in backend/.env (not just here) for container injection
WAZUH_API_HOST=192.168.100.100
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=your-wazuh-api-password-here

# ── AI / LLM Integration ──
GEMINI_API_KEY=your-gemini-api-key-here
