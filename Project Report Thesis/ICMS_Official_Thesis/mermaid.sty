\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mermaid}[2021/08/01]

\RequirePackage{graphicx}
\RequirePackage{environ}

\newcounter{mermaidcounter}

\NewEnviron{mermaid}[1][]{%
  \stepcounter{mermaidcounter}%
  \xdef\mermaidpdf{\jobname-mermaid-\arabic{mermaidcounter}.pdf}%
  \def\emptyopt{}%
  \def\mermaidopts{#1}%
  \ifx\mermaidopts\emptyopt
    \includegraphics{\mermaidpdf}%
  \else
    \includegraphics[\mermaidopts]{\mermaidpdf}%
  \fi
}
