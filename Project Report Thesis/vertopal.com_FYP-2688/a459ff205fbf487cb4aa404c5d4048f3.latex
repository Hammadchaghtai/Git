\begin{quote}
The accuracy of the Rogue Device Detection System was measured as
follows:
\end{quote}

\begin{itemize}
\item
  \begin{quote}
  \textbf{True Positives}: Correctly identified rogue devices present in
  the network.
  \end{quote}
\item
  \begin{quote}
  \textbf{True Negatives}: Correctly identified authorized devices
  without false alerts.
  \end{quote}
\item
  \begin{quote}
  \textbf{False Positives and Negatives}: Cases where authorized devices
  were incorrectly flagged, or rogue devices were missed, were minimized
  during tuning.
  \end{quote}
\end{itemize}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
