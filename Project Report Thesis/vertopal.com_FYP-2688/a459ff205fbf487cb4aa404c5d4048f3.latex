\begin{quote}
\protect\hypertarget{_bookmark36}{}{}\textbf{Chapter 3}

\textbf{Requirement Specification}
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_bookmark37}{}{}\textbf{Introduction}
\end{enumerate}

\begin{quote}
The Rogue Device Detection System is designed to enhance network
security within LAN environments by identifying unauthorized devices and
ensuring that only verified devices are allowed to connect. The system
integrates multiple detection strategies, including active scanning,
whitelist verification, promiscuous mode monitoring, OEM/OUI-based
identification, and real-time alerts. This chapter outlines the
functional and non-functional requirements for the system, detailing the
standards and expectations necessary to develop an effective and secure
solution.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \protect\hypertarget{_bookmark38}{}{}\textbf{Functional Requirements}
\end{enumerate}

\begin{quote}
Functional requirements describe the specific features and functions
that the system must perform to achieve its objectives.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \protect\hypertarget{_bookmark39}{}{}\textbf{Device Discovery}

  \begin{itemize}
  \item
    \textbf{Active Network Scanning:} The system must actively scan the
    LAN network using tools like Nmap. The scan will discover all
    connected devices by gathering IP addresses, MAC addresses, and
    identifying open ports.
  \item
    \textbf{Identification Using Network Protocols:} The system should
    use network protocols such as ICMP for reachability, ARP for
    IP-to-MAC mapping, and LLDP/CDP for identifying neighboring devices
    to create a detailed list of network devices.
  \end{itemize}
\item
  \protect\hypertarget{_bookmark40}{}{}\textbf{Whitelist Verification}

  \begin{itemize}
  \item
    \textbf{MAC Address Whitelist Comparison:} The system must maintain
    a whitelist that includes the MAC addresses of all authorized
    devices. Each device detected by
  \end{itemize}
\end{enumerate}

\begin{quote}
14

the scan must be compared against this list. If a MAC address is not
found in the whitelist, the device is flagged as rogue.
\end{quote}

\begin{itemize}
\item
  \begin{quote}
  \textbf{Threshold Attribute Verification:} The system must verify
  additional device at- tributes such as device type, hostname, and
  operating system against expected values. If these attributes fall
  outside of established thresholds, the device should be flagged as
  potentially compromised, even if its MAC address is whitelisted.
  \end{quote}
\end{itemize}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark41}{}{}\textbf{Manufacturer
  Verification}
  \end{quote}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{OEM/OUI-Based Identification:} The system must analyze the
    OUI portion of each detected device's MAC address to determine the
    manufacturer. Devices with an unrecognized OUI or from a
    manufacturer not on the trusted list must be flagged as suspicious.
    \end{quote}
  \item
    \begin{quote}
    \textbf{MAC Spoofing Detection:} The system must use OUI-based
    identification to help detect MAC address spoofing. If a device's
    manufacturer details do not match expected values, the system will
    trigger an alert.
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{passive-monitoring-with-promiscuous-mode}{%
  \subsubsection{Passive Monitoring with Promiscuous
  Mode}\label{passive-monitoring-with-promiscuous-mode}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Promiscuous Mode NIC Configuration:} The system's Network
    Interface Card (NIC) must be configured in promiscuous mode to
    capture all packets passing through the network. This will ensure
    that all activity---including traffic not directed to the detection
    device---can be monitored for potential rogue activity.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Monitoring of ARP Requests and Network Traffic:} The system
    must passively monitor ARP requests, broadcast traffic, and other
    network packets to detect hidden devices or suspicious activities,
    such as man-in-the-middle (MITM) attacks.
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{real-time-alerts-and-reporting}{%
  \subsubsection{Real-Time Alerts and
  Reporting}\label{real-time-alerts-and-reporting}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Real-Time Alerts:} The system must generate real-time alerts
    for the network admin- istrator when a device is flagged as rogue
    based on the whitelist verification and OUI analysis. Alerts should
    include detailed information, such as the MAC address, IP address,
    and the reason for the flag.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Detailed Logging and Reports:} The system must maintain a
    detailed log of all device activities, including successful and
    failed verification attempts. This log should be accessible for
    auditing and reporting purposes and should be exportable for further
    analysis.
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{administrator-dashboard-and-interface}{%
  \subsubsection{Administrator Dashboard and
  Interface}\label{administrator-dashboard-and-interface}}

  \begin{itemize}
  \item
    \textbf{Web-Based Administrator Interface:} The system must provide
    an intuitive web- based dashboard built using Django. The dashboard
    should enable the administrator to:
  \end{itemize}
\end{enumerate}

\begin{itemize}
\item
  \begin{quote}
  View real-time device information and alerts.
  \end{quote}
\item
  \begin{quote}
  Manage and update the device whitelist.
  \end{quote}
\item
  \begin{quote}
  Analyze historical logs and reports of network activity.
  \end{quote}

  \begin{itemize}
  \item
    \textbf{Device and User Management:} The administrator should be
    able to add, edit, or remove devices from the whitelist and modify
    alert settings from the web interface.
  \end{itemize}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{non-functional-requirements}{%
    \subsection{Non-Functional
    Requirements}\label{non-functional-requirements}}
  \end{enumerate}
\end{itemize}

\begin{quote}
Non-functional requirements define the system's operational qualities
and standards, in- cluding performance, usability, reliability, and
security expectations.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item ~
  \hypertarget{performance-requirements}{%
  \subsubsection{Performance
  Requirements}\label{performance-requirements}}

  \begin{itemize}
  \item
    \textbf{Real-Time Processing:} The system must be capable of
    monitoring the network in real-time, providing alerts with a
    response latency of less than 2 seconds from the time an
    unauthorized device is detected.
  \item
    \textbf{Scalability:} The system must support scalability to
    accommodate networks of varying sizes. It should be efficient enough
    to handle environments with tens to hundreds of devices without
    compromising performance.
  \end{itemize}
\item ~
  \hypertarget{security-requirements}{%
  \subsubsection{Security Requirements}\label{security-requirements}}

  \begin{itemize}
  \item
    \textbf{Data Security and Encryption:} Communication between the
    administrator dash- board and the detection system must be encrypted
    using TLS to protect sensitive information.
  \item
    \textbf{Access Control:} The system must implement role-based access
    control (RBAC) to ensure that only authorized users can make
    modifications to the whitelist or access device logs.
  \end{itemize}
\item ~
  \hypertarget{reliability-and-availability}{%
  \subsubsection{Reliability and
  Availability}\label{reliability-and-availability}}

  \begin{itemize}
  \item
    \textbf{High Availability:} The system must be operational 24/7 with
    an uptime of at least 99.5\%, ensuring uninterrupted monitoring of
    the network.
  \item
    \begin{quote}
    \textbf{Backup and Recovery:} The system must support regular backup
    of the whitelist data, logs, and configurations to ensure that no
    information is lost in the event of a system failure. Backups must
    be automated and occur at least once daily.
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{usability-requirements}{%
  \subsubsection{Usability Requirements}\label{usability-requirements}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{User-Friendly Interface:} The Administrator Dashboard must
    be intuitive and easy to navigate, providing visual representations
    such as charts and alerts to make the system's status and activities
    easy to understand.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Dashboard Customization:} The dashboard should allow the
    administrator to cus- tomize settings, including defining alert
    thresholds, configuring reports, and filtering device data based on
    specific parameters.
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{compliance-requirements}{%
  \subsubsection{Compliance
  Requirements}\label{compliance-requirements}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Industry Standards Compliance:} The system must comply with
    ISO 27001 and CIS Controls for network security, ensuring adherence
    to modern security standards.
    \end{quote}
  \end{itemize}
\end{enumerate}

\hypertarget{system-models-and-components}{%
\subsection{System Models and
Components}\label{system-models-and-components}}

\begin{quote}
This section describes the different components that work together to
implement the Rogue Device Detection System and how they interact to
achieve the system's objectives.
\end{quote}

\hypertarget{system-architecture}{%
\subsubsection{System Architecture}\label{system-architecture}}

\begin{quote}
The system is composed of several distinct components that work in
tandem to provide a complete rogue device detection solution:
\end{quote}

\begin{itemize}
\item
  \begin{quote}
  \textbf{Network Scanning Module:} Uses Nmap and other protocols to
  discover devices on the network, collecting their identifiers (IP,
  MAC, etc.) for further verification.
  \end{quote}
\item
  \begin{quote}
  \textbf{Whitelist Verification Module:} Compares the detected devices
  against a whitelist to determine if they are authorized, checking both
  MAC addresses and device attributes.
  \end{quote}
\item
  \begin{quote}
  \textbf{Passive Monitoring Module:} Configures the NIC in promiscuous
  mode to capture all network packets. This ensures complete visibility
  and helps identify stealthy devices and anomalous behaviors.
  \end{quote}
\item
  \begin{quote}
  \textbf{Packet Analysis Integration:} Uses Wireshark for in-depth
  packet analysis, support- ing the identification of rogue devices by
  analyzing network traffic in detail.
  \end{quote}
\item
  \begin{quote}
  \textbf{Administrator Dashboard:} Built using Django, the web
  interface allows adminis- trators to view network activity, manage
  devices, and receive alerts.
  \end{quote}
\end{itemize}

\begin{itemize}
\item
  \textbf{Database (PostgreSQL):} Stores whitelist data, device logs,
  and historical records for auditing and analysis.

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{context-diagram}{%
    \subsubsection{Context Diagram}\label{context-diagram}}
  \end{enumerate}
\end{itemize}

\begin{quote}
The context diagram illustrates the interactions between the system
components and external entities.
\end{quote}

\includegraphics[width=4.66229in,height=3.54104in]{vertopal_a459ff205fbf487cb4aa404c5d4048f3/media/image3.jpeg}

\begin{quote}
\protect\hypertarget{_bookmark54}{}{}Figure 3.1: Context Diagram for the
Rogue Device Detection System
\end{quote}

\hypertarget{data-flow-diagram}{%
\subsubsection{Data Flow Diagram}\label{data-flow-diagram}}

\begin{quote}
The data flow through the system involves the following steps:
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \textbf{Network Scanning:} The Network Scanning Module performs an
  active scan of all network devices.
\item
  \textbf{Whitelist and Verification:} Detected devices are compared
  against the whitelist. If a match is found, the device is verified. If
  not, it is flagged as rogue.
\item
  \textbf{Passive Traffic Monitoring:} The Passive Monitoring Module
  captures all network traffic and provides additional verification
  using Wireshark for packet analysis.
\item
  \textbf{Alert Generation:} If a rogue device is detected, an alert is
  generated and logged in the database.
\item
  \begin{quote}
  \textbf{Administrator Dashboard:} Administrators can view alerts,
  modify the whitelist, and analyze historical data through the web
  interface.
  \end{quote}
\end{enumerate}

\includegraphics[width=4.56781in,height=3.30469in]{vertopal_a459ff205fbf487cb4aa404c5d4048f3/media/image4.jpeg}

\begin{quote}
\protect\hypertarget{_bookmark56}{}{}Figure 3.2: Data Flow Diagram for
the Rogue Device Detection System
\end{quote}

\hypertarget{external-interface-requirements}{%
\subsection{External Interface
Requirements}\label{external-interface-requirements}}

\begin{itemize}
\item
  \begin{quote}
  \textbf{User Interface:} The Administrator Dashboard must be
  accessible through modern web browsers (e.g., Chrome, Firefox) and
  optimized for desktop use.
  \end{quote}
\item
  \begin{quote}
  \textbf{Hardware Interface:} The detection system must be deployed on
  a machine with a NIC capable of being configured in promiscuous mode
  for passive monitoring.
  \end{quote}
\item
  \begin{quote}
  \textbf{Communication Interfaces:} Integration with packet analysis
  tools like Wireshark must be supported to provide deep packet
  inspection and detailed analysis.
  \end{quote}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{system-constraints}{%
    \subsection{System Constraints}\label{system-constraints}}

    \begin{enumerate}
    \def\labelenumii{\arabic{enumii}.}
    \item ~
      \hypertarget{network-configuration}{%
      \subsubsection{Network
      Configuration}\label{network-configuration}}

      \begin{itemize}
      \item
        \begin{quote}
        The system relies on proper network configurations, such as
        ensuring ICMP and CDP/LLDP packets are allowed. Incorrect
        configurations may lead to incomplete scanning or missed
        devices.
        \end{quote}
      \end{itemize}
    \end{enumerate}
  \end{enumerate}
\end{itemize}

\begin{itemize}
\item
  All devices must be connected in a way that enables the system to scan
  them fully; devices on isolated segments or VLANs might not be
  detected without additional configuration.

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{database-dependencies}{%
    \subsubsection{Database Dependencies}\label{database-dependencies}}

    \begin{itemize}
    \item
      The project uses a PostgreSQL database to store details about
      authorized and rogue devices. The availability and stability of
      the database server are critical for the system's functionality.
    \item
      Limited database performance may affect real-time processing,
      particularly for large networks with a significant number of
      devices.
    \end{itemize}
  \item ~
    \hypertarget{real-time-detection-and-network-load}{%
    \subsubsection{Real-Time Detection and Network
    Load}\label{real-time-detection-and-network-load}}

    \begin{itemize}
    \item
      Network scanning can create extra load on the network and
      potentially disrupt performance, especially during peak times.
      Careful planning is required to balance detection frequency and
      network stability.
    \end{itemize}
  \item ~
    \hypertarget{scalability}{%
    \subsubsection{Scalability}\label{scalability}}

    \begin{itemize}
    \item
      The system is designed for small to medium-sized enterprise (SME)
      networks. Scal- ing it up for large enterprise networks may
      require optimization, such as distributing the scanning load or
      upgrading server resources.
    \item
      The whitelist verification process can become complex and slower
      as the size of the authorized device list grows, requiring more
      efficient methods to maintain scalability.
    \end{itemize}
  \item ~
    \hypertarget{integration-limitations}{%
    \subsubsection{Integration
    Limitations}\label{integration-limitations}}

    \begin{itemize}
    \item
      Ensuring compatibility between the Django framework and
      third-party tools while managing database integration with
      PostgreSQL.
    \item
      Addressing potential security vulnerabilities introduced by
      external tools and latency issues between integrated modules.
    \item
      Managing version control to maintain compatibility and prevent
      system instability when updates are introduced.
    \end{itemize}
  \item ~
    \hypertarget{compliance-requirements-1}{%
    \subsubsection{Compliance
    Requirements}\label{compliance-requirements-1}}

    \begin{itemize}
    \item
      The system must comply with industry standards such as ISO 27001
      and CIS Controls for network security. Any changes in these
      standards may require updates to system functionalities to
      maintain compliance.
    \item
      \begin{quote}
      Security requirements such as encryption, data protection, and
      access control must be strictly adhered to, which can be
      challenging given the continuously evolving regulatory landscape.
      \end{quote}
    \end{itemize}
  \item ~
    \hypertarget{user-dependence}{%
    \subsubsection{User Dependence}\label{user-dependence}}

    \begin{itemize}
    \item
      \begin{quote}
      The system's efficiency depends on the network administrator
      keeping the whitelist updated. Delays in adding or removing
      authorized devices may lead to false positives or allow rogue
      devices to evade detection.
      \end{quote}
    \item
      \begin{quote}
      Training for the network administrator is required to effectively
      manage alerts and interpret reports.
      \end{quote}
    \end{itemize}
  \end{enumerate}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{use-case-diagram}{%
    \subsection{Use Case Diagram}\label{use-case-diagram}}
  \end{enumerate}
\end{itemize}

\begin{quote}
The Use Case Diagram represents the interactions between actors and the
system.
\end{quote}

