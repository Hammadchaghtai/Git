\protect\hypertarget{_bookmark75}{}{}\textbf{Chapter 4}

\textbf{System Design}
\end{quote}

\hypertarget{introduction}{%
\subsection{Introduction}\label{introduction}}

\begin{quote}
The design phase of the Rogue Device Detection System aims to convert
the requirements defined in the earlier stages into a detailed system
structure. The design encompasses the architecture, components, user
interface, and data flow, ensuring that all requirements are
systematically addressed and that the system is both robust and
scalable. This chapter elaborates on the architecture, interfaces,
components, data models, and specific design decisions, thereby
providing a roadmap for implementation. PostgreSQL has been selected as
the primary database technology due to its reliability, scalability, and
capability to handle complex queries efficiently.
\end{quote}

\hypertarget{architectural-design}{%
\subsection{Architectural Design}\label{architectural-design}}

\begin{quote}
The architectural design of the Rogue Device Detection System defines
how different components interact and contribute to detecting
unauthorized devices in a LAN. The system follows a modular
client-server architecture, which allows for scalability and
flexibility.
\end{quote}

\hypertarget{system-architecture-overview}{%
\subsubsection{System Architecture
Overview}\label{system-architecture-overview}}

\begin{quote}
The system is built on a modular architecture, separating key functional
components:
\end{quote}

\begin{itemize}
\item
  \textbf{Network Scanning Module:} Responsible for scanning all devices
  connected to the network.
\item
  \textbf{Whitelist Verification Module:} Verifies devices by comparing
  them against the whitelist.
\item
  \textbf{OEM/OUI Identification Module:} Identifies the manufacturer of
  a detected device for verification.
\end{itemize}

\begin{quote}
24
\end{quote}

\begin{itemize}
\item
  \begin{quote}
  \textbf{Passive Monitoring Module:} Uses promiscuous mode to monitor
  all packets in the network segment.
  \end{quote}
\item
  \begin{quote}
  \textbf{Administrator Dashboard:} A user-friendly web-based interface
  that allows network administrators to manage devices, view alerts, and
  update settings.
  \end{quote}
\item
  \begin{quote}
  \textbf{Alert System:} Generates alerts when rogue devices are
  detected.
  \end{quote}
\item
  \begin{quote}
  \textbf{Database Module (PostgreSQL):} Stores both the Whitelist
  Database and Device Log Database, enabling efficient handling of
  network devices' information and historical logs.
  \end{quote}
\end{itemize}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item ~
  \hypertarget{high-level-design-goals}{%
  \subsubsection{High-Level Design
  Goals}\label{high-level-design-goals}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Scalability:} The system should accommodate an increasing
    number of devices without a decrease in performance, supported by
    the scalability of PostgreSQL.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Maintainability:} The system is modular, which allows for
    easy maintenance and upgrades.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Security:} All communications must be encrypted, and
    unauthorized devices must be accurately detected and blocked.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Real-Time Monitoring:} Provide immediate detection and
    alerting of unauthorized devices.
    \end{quote}
  \end{itemize}
\end{enumerate}

\hypertarget{system-models}{%
\subsection{System Models}\label{system-models}}

\begin{quote}
The system models provide a visual representation of how the various
components of the Rogue Device Detection System interact with each
other.
\end{quote}

\hypertarget{sequence-diagram}{%
\subsubsection{Sequence Diagram}\label{sequence-diagram}}

\begin{quote}
The Sequence Diagram illustrates the interaction between components in a
step-by-step manner. The key sequence is:
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \begin{quote}
  Network Administrator initiates the scanning process.
  \end{quote}
\item
  \begin{quote}
  The Network Scanning Module scans the network.
  \end{quote}
\item
  \begin{quote}
  Whitelist Verification Module checks each detected device.
  \end{quote}
\item
  \begin{quote}
  OEM/OUI Identification Module performs manufacturer verification.
  \end{quote}
\item
  \begin{quote}
  If discrepancies are found, alerts are generated and sent to the
  Administrator Dash- board.
  \end{quote}
\end{enumerate}

\begin{quote}
\includegraphics[width=4.64844in,height=2.46458in]{vertopal_a459ff205fbf487cb4aa404c5d4048f3/media/image6.jpeg}

\protect\hypertarget{_bookmark82}{}{}Figure 4.1: Use Case Diagram for
the Rogue Device Detection System
\end{quote}

\hypertarget{detailed-component-design}{%
\subsection{Detailed Component Design}\label{detailed-component-design}}

\begin{quote}
Each major system component is detailed here, providing insight into its
role, responsibili- ties, and interaction with other components.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item ~
  \hypertarget{network-scanning-module}{%
  \subsubsection{Network Scanning
  Module}\label{network-scanning-module}}

  \begin{itemize}
  \item
    \textbf{Function:} Responsible for discovering all devices connected
    to the network using tools like Nmap.
  \item
    \begin{quote}
    \textbf{Inputs:} Triggered by the Network Administrator or
    Monitoring System.
    \end{quote}
  \item
    \textbf{Outputs:} Generates a list of devices (e.g., MAC addresses,
    IP addresses, device types).
  \item
    \textbf{Implementation Details:} Implements ARP requests and ICMP
    for scanning, gather- ing basic device information for processing.
  \end{itemize}
\item ~
  \hypertarget{whitelist-verification-module}{%
  \subsubsection{Whitelist Verification
  Module}\label{whitelist-verification-module}}

  \begin{itemize}
  \item
    \textbf{Function:} Verifies whether the device is authorized by
    comparing its MAC address against a Whitelist Database stored in
    PostgreSQL.
  \item
    \begin{quote}
    \textbf{Inputs:} List of devices from the Network Scanning Module.
    \end{quote}
  \item
    \textbf{Outputs:} Two lists---verified devices and rogue devices.
  \item
    \textbf{Data Flow:} Communicates with the Whitelist Database stored
    in PostgreSQL to access authorized devices efficiently.
  \end{itemize}
\item ~
  \hypertarget{oemoui-identification-module}{%
  \subsubsection{OEM/OUI Identification
  Module}\label{oemoui-identification-module}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Function:} Identifies the manufacturer of each detected
    device by analyzing the OUI from the MAC address.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Inputs:} List of detected devices.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Outputs:} Manufacturer details, which are used to determine
    if the device is from an authorized vendor.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Design Decision:} This module helps in identifying MAC
    spoofing and flagging unauthorized devices based on manufacturer
    analysis.
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{passive-monitoring-module}{%
  \subsubsection{Passive Monitoring
  Module}\label{passive-monitoring-module}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Function:} Configures the Network Interface Card (NIC) in
    promiscuous mode to capture all traffic on the network.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Purpose:} Provides passive monitoring, which is important
    for detecting rogue devices that do not actively communicate with
    the rest of the network.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Inputs:} Network packets from all connected devices.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Outputs:} Alerts if anomalies are detected (e.g., ARP
    spoofing).
    \end{quote}
  \end{itemize}
\item ~
  \hypertarget{administrator-dashboard}{%
  \subsubsection{Administrator
  Dashboard}\label{administrator-dashboard}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{User Interface:} Built using Django to provide an intuitive
    and secure interface for the Network Administrator.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Features:}
    \end{quote}
  \end{itemize}
\end{enumerate}

\begin{itemize}
\item
  \begin{quote}
  \textbf{Real-Time Monitoring:} Displays real-time alerts, device
  details, and monitor- ing statistics.
  \end{quote}
\item
  \begin{quote}
  \textbf{Whitelist Management:} Allows administrators to add, edit, or
  delete devices from the Whitelist stored in PostgreSQL.
  \end{quote}
\item
  \begin{quote}
  \textbf{Log Analysis and Reporting:} Generates reports from stored
  logs in Post- greSQL, providing a historical view of network activity.
  \end{quote}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{alert-system}{%
    \subsubsection{Alert System}\label{alert-system}}

    \begin{itemize}
    \item
      \begin{quote}
      \textbf{Function:} Generates alerts if unauthorized or rogue
      devices are detected.
      \end{quote}
    \item
      \begin{quote}
      \textbf{Outputs:} Sends alerts to the Administrator Dashboard and
      stores them in the Device Log Database in PostgreSQL for future
      auditing.
      \end{quote}
    \end{itemize}
  \end{enumerate}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{activity-diagram}{%
    \subsection{Activity Diagram}\label{activity-diagram}}
  \end{enumerate}
\end{itemize}

\includegraphics[width=5.7125in,height=7.9in]{vertopal_a459ff205fbf487cb4aa404c5d4048f3/media/image7.jpeg}

\begin{quote}
\protect\hypertarget{_bookmark91}{}{}Figure 4.2: Activity Diagram for
Rogue Device Detection System
\end{quote}

\hypertarget{data-design}{%
\subsection{Data Design}\label{data-design}}

\begin{quote}
Data design focuses on structuring and storing the necessary data
required by the Rogue Device Detection System. PostgreSQL is used as the
main database management system to store and handle the data
efficiently.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item ~
  \hypertarget{database-schema-design}{%
  \subsubsection{Database Schema Design}\label{database-schema-design}}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Whitelist Database (PostgreSQL):}
    \end{quote}
  \end{itemize}
\end{enumerate}

\begin{itemize}
\item
  \begin{quote}
  \textbf{MAC Address (Primary Key):} A unique identifier for each
  authorized device.
  \end{quote}
\item
  \begin{quote}
  \textbf{Device Type:} Type of device (e.g., printer, computer).
  \end{quote}
\item
  \begin{quote}
  \textbf{Authorized Timestamp:} The date and time when the device was
  authorized.
  \end{quote}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Device Log Database (PostgreSQL):}
    \end{quote}
  \end{itemize}
\end{itemize}

\begin{itemize}
\item
  \begin{quote}
  \textbf{Device ID:} Unique identifier for each detected device.
  \end{quote}
\item
  \begin{quote}
  \textbf{Timestamp:} The date and time the device was detected or
  verified.
  \end{quote}
\item
  \begin{quote}
  \textbf{Alert Type:} Stores details if an alert was generated.
  \end{quote}
\item
  \begin{quote}
  \textbf{Network Details:} Includes IP address, hostname, and other
  metadata.
  \end{quote}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{data-flow-management}{%
    \subsubsection{Data Flow Management}\label{data-flow-management}}

    \begin{itemize}
    \item
      \begin{quote}
      Data flows between the Network Scanning Module, Whitelist
      Verification Module, and OEM/OUI Identification Module.
      \end{quote}
    \item
      \begin{quote}
      Logs are stored and retrieved from the Device Log Database
      (PostgreSQL) for audit and monitoring purposes.
      \end{quote}
    \item
      \begin{quote}
      The Administrator Dashboard accesses data from both Whitelist and
      Log Databases in PostgreSQL.
      \end{quote}
    \end{itemize}
  \end{enumerate}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item ~
    \hypertarget{entity-relation-diagram}{%
    \subsection{Entity Relation Diagram}\label{entity-relation-diagram}}
  \end{enumerate}
\end{itemize}

\begin{quote}
The entity-relationship diagram (ERD) showcases the relationships among
key entities such as the whitelist, detected devices, and logged alerts.

\includegraphics[width=6.3125in,height=7.57292in]{vertopal_a459ff205fbf487cb4aa404c5d4048f3/media/image8.jpeg}

\protect\hypertarget{_bookmark96}{}{}Figure 4.3: Entity-Relationship
Diagram for Rogue Device Detection System
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{1}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark97}{}{}\textbf{User Interface Design}
  \end{quote}
\end{enumerate}

\begin{quote}
The Administrator Dashboard serves as the main point of interaction for
the Network Administrator.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark98}{}{}\textbf{Dashboard Layout}
  \end{quote}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Main Panel:} Displays real-time alerts, active devices, and
    their statuses.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Whitelist Management:} Provides options to add, remove, and
    modify entries in the Whitelist Database in PostgreSQL.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Reports Section:} Generates network activity reports and
    offers the ability to filter by date, device, and alert level.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Alert Management:} Displays historical alerts and
    categorizes them by severity.
    \end{quote}
  \end{itemize}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark99}{}{}\textbf{User Interaction
  Workflow}
  \end{quote}

  \begin{itemize}
  \item
    \begin{quote}
    The administrator logs in and views the current status of devices.
    \end{quote}
  \item
    \begin{quote}
    Alerts are categorized by severity, and the administrator can take
    action (e.g., add an unknown device to the whitelist if deemed
    safe).
    \end{quote}
  \item
    \begin{quote}
    The dashboard includes navigation panels for easy device management,
    log analysis, and alert monitoring.
    \end{quote}
  \end{itemize}
\end{enumerate}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\setcounter{enumi}{2}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark100}{}{}\textbf{Security Design
  Considerations}
  \end{quote}
\end{enumerate}

\begin{quote}
Security is a primary concern, given that the system handles sensitive
network data.
\end{quote}

\begin{enumerate}
\def\labelenumi{\arabic{enumi}.}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark101}{}{}\textbf{Authentication and
  Access Control}
  \end{quote}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Role-Based Access Control (RBAC):} Ensures that only
    authorized personnel can modify device settings or whitelist
    entries.
    \end{quote}
  \item
    \begin{quote}
    \textbf{Secure Login Mechanism:} Uses multi-factor authentication
    (MFA) to prevent unauthorized access to the Administrator Dashboard.
    \end{quote}
  \end{itemize}
\item
  \begin{quote}
  \protect\hypertarget{_bookmark102}{}{}\textbf{Data Security}
  \end{quote}

  \begin{itemize}
  \item
    \begin{quote}
    \textbf{Encryption:} All communication between modules and the
    PostgreSQL database is encrypted using TLS (Transport Layer
    Security).
    \end{quote}
  \end{itemize}
\end{enumerate}

\begin{itemize}
\item
  \textbf{Data Integrity:} Hashing algorithms are used to maintain the
  integrity of device logs and prevent tampering.

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_bookmark103}{}{}\textbf{Network Security}

    \begin{itemize}
    \item
      \textbf{Anomalous Behavior Monitoring:} The system actively
      monitors anomalous net- work behavior using packet analysis
      techniques provided by the Passive Monitoring Module.
    \item
      \textbf{Alert Generation:} Immediate alerting for any
      man-in-the-middle (MITM) attacks, MAC spoofing, or unauthorized
      devices helps in proactive mitigation of threats.
    \end{itemize}
  \end{enumerate}

  \begin{enumerate}
  \def\labelenumi{\arabic{enumi}.}
  \item
    \protect\hypertarget{_bookmark104}{}{}\textbf{Hardware and System
    Requirements}

    \begin{enumerate}
    \def\labelenumii{\arabic{enumii}.}
    \item
      \protect\hypertarget{_bookmark105}{}{}\textbf{Server Requirements}

      \begin{itemize}
      \item
        \begin{quote}
        \textbf{CPU:} Multi-core processor for handling multiple
        simultaneous scans.
        \end{quote}
      \item
        \textbf{Memory:} Minimum of 8 GB RAM for efficient data
        processing.
      \item
        \textbf{Storage:} SSD storage for quick access to the PostgreSQL
        database storing whitelist and log data.
      \end{itemize}
    \item
      \protect\hypertarget{_bookmark106}{}{}\textbf{Network Interface}

      \begin{itemize}
      \item
        \textbf{Promiscuous Mode Capability:} The server must have a NIC
        capable of being set to promiscuous mode for passive monitoring.
      \end{itemize}
    \end{enumerate}
  \item
    \begin{quote}
    \protect\hypertarget{_bookmark107}{}{}\textbf{system Design}
    \end{quote}
  \end{enumerate}
\end{itemize}

