\setcounter{enumi}{1}
\item ~
  \hypertarget{descriptive-use-cases}{%
  \subsection{Descriptive Use Cases}\label{descriptive-use-cases}}

  \begin{enumerate}
  \def\labelenumii{\arabic{enumii}.}
  \item ~
